#!/bin/sh
set -eu

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in
  /*) ;;
  *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

# Follow symlinks so `/usr/local/bin/paseo` resolves back into the app bundle.
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

MACOS_DIR="${RESOURCES_DIR}/../MacOS"

# The bundle's product name is not fixed ("Paseo" upstream, "Paseo Fork" for this
# build), so resolve the helper and main executables by shape rather than by a
# hardcoded name. Any "<Product> Helper.app" under Frameworks is a valid entry.
MACOS_HELPER_EXECUTABLE=""
for helper_app in "${RESOURCES_DIR}/../Frameworks/"*" Helper.app"; do
  [ -d "${helper_app}" ] || continue
  helper_name=$(basename "${helper_app}" .app)
  helper_candidate="${helper_app}/Contents/MacOS/${helper_name}"
  if [ -x "${helper_candidate}" ]; then
    MACOS_HELPER_EXECUTABLE="${helper_candidate}"
    break
  fi
done

# macOS CLI invocations must enter Electron through the agent Helper. Launching
# the main APPL executable here makes later daemon supervision inherit app UI
# lifecycle behavior.
if [ -d "${MACOS_DIR}" ]; then
  if [ -z "${MACOS_HELPER_EXECUTABLE}" ] || [ ! -x "${MACOS_HELPER_EXECUTABLE}" ]; then
    echo "Bundled Paseo Helper executable not found under ${RESOURCES_DIR}/../Frameworks" >&2
    exit 1
  fi
  APP_EXECUTABLE="${MACOS_HELPER_EXECUTABLE}"
else
  APP_EXECUTABLE=""
  for candidate in "${RESOURCES_DIR}/../"*.bin "${RESOURCES_DIR}/../Paseo"*; do
    case "${candidate}" in
      *.so | *.dat | *.pak | *.json) continue ;;
    esac
    if [ -f "${candidate}" ] && [ -x "${candidate}" ]; then
      APP_EXECUTABLE="${candidate}"
      break
    fi
  done
  if [ -z "${APP_EXECUTABLE}" ]; then
    echo "Bundled Paseo executable not found relative to ${RESOURCES_DIR}" >&2
    exit 1
  fi
fi

RUNNER_PATH="${RESOURCES_DIR}/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js"
CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar/node_modules/@getpaseo/cli/dist/index.js"

# PASEO_DESKTOP_MANAGED marks daemons started through this bundled CLI as
# desktop-managed, so the desktop app restarts them when it upgrades.
exec env ELECTRON_RUN_AS_NODE=1 PASEO_NODE_ENV=production PASEO_DESKTOP_MANAGED=1 PASEO_CLI="${SCRIPT_PATH}" "${APP_EXECUTABLE}" --disable-warning=DEP0040 "${RUNNER_PATH}" node-script "${CLI_ENTRYPOINT}" "$@"
